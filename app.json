{
  "expo": {
    "name": "parkd",
    "slug": "parkd",
    "scheme": "parkd",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.compilezen.parkd",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "ar",
          "zh-Hans",
          "es",
          "hi"
        ]
      }
    },
    "android": {
      "package": "com.compilezen.parkd",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFC"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow parkd to save where you parked.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to remember your parking spot.",
          "cameraPermission": "Take a photo to remember your parking spot.",
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.compilezen.parkd.widgets",
          "groupIdentifier": "group.com.compilezen.parkd",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "ParkdParkingWidget",
              "displayName": "parkd",
              "description": "Your parking clues at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./languages/en.json",
      "ar": "./languages/ar.json",
      "zh": "./languages/zh.json",
      "es": "./languages/es.json",
      "hi": "./languages/hi.json"
    }
  }
}
